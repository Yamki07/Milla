<?xml version="1.0" encoding="utf-8"?>
<!--
  Fase 1: Reemplazado por ComposeView.
  Toda la lógica de UI vive en PlayerScreen.kt (Jetpack Compose).
  Se conserva el volumeFragmentContainer para compatibilidad con AbsPlayerControlsFragment.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/composePlayerControls"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Conservado para que hideVolumeIfAvailable() en AbsPlayerControlsFragment no crashee -->
    <FrameLayout
        android:id="@+id/volumeFragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:visibility="gone" />

</FrameLayout>