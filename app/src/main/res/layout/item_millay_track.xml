<?xml version="1.0" encoding="utf-8"?>
<!-- Spotify-style track item for Millay Internet -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="8dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- Album Art with Quality Badge overlay -->
    <FrameLayout
        android:layout_width="56dp"
        android:layout_height="56dp">

        <ImageView
            android:id="@+id/millayTrackArt"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/millay_art_placeholder"
            android:contentDescription="Portada"
            android:scaleType="centerCrop" />

        <!-- Quality Badge — bottom-end corner like Spotify/Monochrome -->
        <TextView
            android:id="@+id/millayTrackQualityBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:background="#CC000000"
            android:fontFamily="@font/manrope_bold"
            android:paddingStart="4dp"
            android:paddingTop="1dp"
            android:paddingEnd="4dp"
            android:paddingBottom="1dp"
            android:text="FLAC"
            android:textColor="#1DB954"
            android:textSize="7sp"
            android:letterSpacing="0.08"
            android:visibility="visible" />

    </FrameLayout>

    <!-- Track Info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Quality label above title (like Spotify HD FLAC label) -->
        <TextView
            android:id="@+id/millayTrackQualityLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#1A1DB954"
            android:fontFamily="@font/manrope_bold"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            android:paddingTop="1dp"
            android:paddingBottom="1dp"
            android:layout_marginBottom="2dp"
            android:text="HD FLAC"
            android:textColor="#1DB954"
            android:textSize="9sp"
            android:letterSpacing="0.05"
            android:visibility="gone" />

        <TextView
            android:id="@+id/millayTrackTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/manrope_bold"
            android:singleLine="true"
            android:text="Track Title"
            android:textColor="@android:color/white"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/millayTrackArtist"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:alpha="0.6"
                android:ellipsize="end"
                android:fontFamily="@font/manrope"
                android:singleLine="true"
                android:text="Artist"
                android:textColor="@android:color/white"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/millayTrackAlbum"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:alpha="0.4"
                android:ellipsize="end"
                android:fontFamily="@font/manrope"
                android:maxWidth="100dp"
                android:singleLine="true"
                android:text="Album"
                android:textColor="@android:color/white"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/millayTrackDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:alpha="0.35"
                android:fontFamily="@font/manrope"
                android:text="3:30"
                android:textColor="@android:color/white"
                android:textSize="11sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Action Buttons — Spotify style (heart + download + more) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/millayTrackLike"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Me gusta"
            android:padding="8dp"
            android:src="@drawable/ic_favorite_border"
            android:tint="#B3FFFFFF" />

        <ImageButton
            android:id="@+id/millayTrackDownload"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Descargar"
            android:padding="8dp"
            android:src="@drawable/ic_save"
            android:tint="#B3FFFFFF" />

        <ImageButton
            android:id="@+id/millayTrackMore"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Más opciones"
            android:padding="8dp"
            android:src="@drawable/ic_more_vert"
            android:tint="#B3FFFFFF" />

    </LinearLayout>

</LinearLayout>
