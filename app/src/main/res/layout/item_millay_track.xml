<?xml version="1.0" encoding="utf-8"?>
<!-- Premium track item for Millay Internet — Apple Music / Monochrome style -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="3dp"
    android:background="@drawable/millay_glass_surface"
    android:gravity="center_vertical"
    android:minHeight="68dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="8dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- Album Art with Quality Badge overlay -->
    <FrameLayout
        android:layout_width="56dp"
        android:layout_height="56dp">

        <ImageView
            android:id="@+id/millayTrackArt"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/millay_art_placeholder"
            android:contentDescription="Portada"
            android:scaleType="centerCrop"
            tools:src="@drawable/millay_art_placeholder" />

        <!-- Quality Badge — bottom-end corner -->
        <TextView
            android:id="@+id/millayTrackQualityBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:background="@drawable/millay_badge_quality"
            android:fontFamily="@font/manrope_bold"
            android:paddingStart="3dp"
            android:paddingTop="1dp"
            android:paddingEnd="3dp"
            android:paddingBottom="1dp"
            android:text="FLAC"
            android:textColor="@android:color/white"
            android:textSize="7sp"
            android:letterSpacing="0.06"
            android:visibility="visible"
            tools:text="FLAC" />

    </FrameLayout>

    <!-- Track Info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Quality label above title (HD FLAC badge) -->
        <TextView
            android:id="@+id/millayTrackQualityLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Millay.QualityBadge"
            android:layout_marginBottom="3dp"
            android:text="HD FLAC"
            android:visibility="gone"
            tools:text="HI-RES"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/millayTrackTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="Track Title"
            style="@style/Millay.TrackTitle"
            tools:text="Midnight Resonance" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/millayTrackArtist"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="Artist"
            style="@style/Millay.TrackSubtitle"
            tools:text="Milla Ensemble" />

            <TextView
                android:id="@+id/millayTrackAlbum"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:ellipsize="end"
                android:maxWidth="100dp"
                android:singleLine="true"
                android:text="Album"
            style="@style/Millay.MetaText"
            tools:text="After Hours" />

            <TextView
                android:id="@+id/millayTrackDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="3:30"
                android:textColor="@color/millay_badge_flac"
                android:fontFamily="@font/manrope"
            android:textSize="11sp"
            tools:text="4:12" />

        </LinearLayout>

    </LinearLayout>

    <!-- Action Buttons — heart + download + more -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/millayTrackLike"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Me gusta"
            android:padding="8dp"
            android:src="@drawable/ic_favorite_border"
            android:tint="@color/millay_text_secondary" />

        <ImageButton
            android:id="@+id/millayTrackDownload"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Descargar"
            android:padding="8dp"
            android:src="@drawable/ic_save"
            android:tint="@color/millay_text_secondary" />

        <ImageButton
            android:id="@+id/millayTrackMore"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Más opciones"
            android:padding="8dp"
            android:src="@drawable/ic_more_vert"
            android:tint="@color/millay_text_secondary" />

    </LinearLayout>

</LinearLayout>
