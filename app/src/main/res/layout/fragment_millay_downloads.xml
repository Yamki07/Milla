<?xml version="1.0" encoding="utf-8"?>
<!-- Tab 3 — Downloads de Millay — dark premium theme -->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/millay_bg_primary">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/downloadsRecycler"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="88dp"
        android:paddingTop="8dp" />

    <!-- Estado vacío: sin descargas -->
    <LinearLayout
        android:id="@+id/emptyDownloads"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="visible">

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📥"
            android:textSize="56sp" />

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tus descargas aparecerán aquí"
            style="@style/Millay.TrackTitle"
            android:textSize="16sp"
            android:gravity="center"
            android:paddingTop="12dp" />

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Busca una canción y toca ⬇️ para descargar"
            style="@style/Millay.TrackSubtitle"
            android:gravity="center"
            android:paddingTop="6dp" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
