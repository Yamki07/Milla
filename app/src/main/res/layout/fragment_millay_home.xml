<?xml version="1.0" encoding="utf-8"?>
<!-- Tab 1 — Home: premium dark layout with Millay palette -->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/millay_bg_primary"
    android:clipToPadding="false"
    android:paddingBottom="88dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top Bar: Home Title + Downloads & Settings icons -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingTop="24dp"
            android:paddingBottom="12dp">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/homeTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:text="Home"
                style="@style/Millay.HeroTitle" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:orientation="horizontal">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/btnHomeDownloads"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/millay_icon_circle_bg"
                    android:padding="8dp"
                    android:src="@drawable/ic_save"
                    app:tint="@color/millay_text_primary" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/btnHomeSettings"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/millay_icon_circle_bg"
                    android:padding="8dp"
                    android:src="@drawable/ic_settings"
                    app:tint="@color/millay_text_primary" />

            </LinearLayout>

        </RelativeLayout>

        <!-- Sección 1: Flow: play how you feel -->
        <com.google.android.material.textview.MaterialTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="12dp"
            android:text="Flow: play how you feel"
            style="@style/Millay.SectionTitle" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/flowRecycler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp" />

        <!-- Sección 2: Continue streaming -->
        <com.google.android.material.textview.MaterialTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingTop="28dp"
            android:paddingBottom="12dp"
            android:text="Continue streaming"
            style="@style/Millay.SectionTitle" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/continueStreamingRecycler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp" />

        <!-- Sección 3: Discover -->
        <com.google.android.material.textview.MaterialTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingTop="28dp"
            android:paddingBottom="12dp"
            android:text="Discover"
            style="@style/Millay.SectionTitle" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/discoverRecycler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp" />

        <!-- Sección 4: Go beyond streaming -->
        <com.google.android.material.textview.MaterialTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingTop="28dp"
            android:paddingBottom="12dp"
            android:text="Go beyond streaming"
            style="@style/Millay.SectionTitle" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/topChartsRecycler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
