<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/infiniteRadioCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="12dp"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="24dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="#20FFFFFF"
    app:strokeWidth="1dp"
    app:strokeColor="#40FFFFFF">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:padding="20dp">

        <ImageView
            android:id="@+id/ivInfiniteRadioBg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:alpha="0.2"
            android:src="@drawable/default_audio_art" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Radio Infinita"
                android:textColor="@android:color/white"
                android:textSize="22sp"
                android:fontFamily="@font/manrope_bold"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Música ininterrumpida basada en tus gustos"
                android:textColor="#B3FFFFFF"
                android:textSize="14sp"
                android:fontFamily="@font/manrope" />
        </LinearLayout>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabPlayInfiniteRadio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_play_arrow"
            app:backgroundTint="?attr/colorAccent"
            app:tint="@android:color/white"
            app:fabSize="mini"
            app:elevation="4dp" />

    </RelativeLayout>
</com.google.android.material.card.MaterialCardView>
