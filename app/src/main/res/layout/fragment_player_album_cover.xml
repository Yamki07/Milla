<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.viewpager.widget.ViewPager
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="@integer/overScrollMode"
        tools:background="@drawable/millay_art_placeholder">

    </androidx.viewpager.widget.ViewPager>

    <code.name.monkey.retromusic.views.SyncedLyricsView
        android:id="@+id/lyricsView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="16dp"
        android:visibility="gone"
        tools:visibility="gone" />

    <!-- Solo para Design/Split: representa líneas LRC sin iniciar el motor real. -->
    <androidx.recyclerview.widget.RecyclerView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="28dp"
        android:visibility="gone"
        android:clipToPadding="false"
        android:paddingTop="76dp"
        android:paddingBottom="76dp"
        tools:itemCount="5"
        tools:listitem="@layout/item_lyric_line"
        tools:visibility="visible" />
</FrameLayout>
