<?xml version="1.0" encoding="utf-8"?>
<!-- Genre card gradient backgrounds — each genre gets a unique look via code -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="135"
        android:startColor="@color/millay_bg_card"
        android:endColor="@color/millay_bg_elevated"
        android:type="linear" />
    <corners android:radius="14dp" />
    <stroke
        android:width="1dp"
        android:color="@color/millay_border_subtle" />
</shape>
